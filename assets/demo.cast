[0.001,"o","\u001b]2;NKUBE_E2E=1 '/home/data/felegy/nkube/artifacts/publish/linux-x64/nkube'   \u0007\u001b]1;nkube\u0007"]
[0.023,"o","\u001b[?1h\u001b=Description:\r\r\n  nkube is a native .NET Kubernetes developer CLI that takes you from project to deployment, \r\r\n  testing, and interactive debugging, while keeping the essential kubectl workflow familiar\r\r\n\r\r\nUsage:\r\r\n  nkube [command] [options]\r\r\n\r\r\n"]
[0.001,"o","Options:\r\r\n  --as <as>                                        Username to impersonate for the operation. User "]
[0.001,"o","\r\r\n"]
[0,"o","                                                   could be a regular user or a service account in "]
[0.001,"o","\r\r\n                                                   a namespace.\r\r\n"]
[0,"o","  --as-group <as-group>"]
[0,"o","                            Group to impersonate for the operation, this "]
[0,"o","\r\r\n"]
[0,"o","  "]
[0,"o","                                                 flag can be repeated to specify multiple groups."]
[0,"o","\r\r\n  --as-uid <as-uid>                                UID to impersonate for the operation.\r\r\n"]
[0.001,"o","  --as-user-extra <as-user-extra>"]
[0,"o","                  User extras to impersonate for the operation, "]
[0,"o","\r\r\n"]
[0,"o","                                                   this flag can be repeated to specify multiple \r\r\n"]
[0,"o","                                                   values for the same key."]
[0,"o","\r\r\n"]
[0.001,"o","  --cache-dir <cache-dir>"]
[0,"o","                          Default cache directory\r\r\n  --certificate-authority <certificate-authority>"]
[0,"o","  Path to a cert file for the certificate authority"]
[0,"o","\r\r\n  --client-certificate <client-certificate>        Path to a client certificate file for TLS"]
[0.001,"o","\r\r\n  --client-key <client-key>                        Path to a client key file for TLS\r\r\n  --cluster <cluster>"]
[0,"o","                              The name of the kubeconfig cluster to use\r\r\n"]
[0,"o","  --context <context>                              The name of the kubeconfig context to use\r\r\n  --disable-compression"]
[0.001,"o","                            If true, opt-out of response compression for all \r\r\n"]
[0,"o","                                                   requests to the server\r\r\n  --insecure-skip-tls-verify"]
[0,"o","                       If true, the server's certificate will not be "]
[0,"o","\r\r\n"]
[0,"o","                                                   checked for validity. This will make your HTTPS "]
[0.001,"o","\r\r\n                                                   connections insecure\r\r\n  --kubeconfig <kubeconfig>"]
[0,"o","                        Path to the kubeconfig file to use for CLI \r\r\n                                                   requests.\r\r\n  --kuberc <kuberc>                                Path to the kuberc file to use for preferences. \r\r\n  "]
[0.001,"o","                                                 This can be disabled by exporting \r\r\n                                                   KUBECTL_KUBERC=false feature gate or turning off \r\r\n"]
[0.001,"o","                                                   the feature KUBERC=off.\r\r\n  --log-flush-frequency <log-flush-frequency>      Maximum number of seconds between log flushes \r\r\n  "]
[0,"o","                                                 [default: 5s]\r\r\n  --match-server-version                           Require server version to match client version"]
[0,"o","\r\r\n  -n, --namespace <namespace>"]
[0,"o","                      If present, the namespace scope for this CLI "]
[0.001,"o","\r\r\n"]
[0,"o","                                                   request"]
[0,"o","\r\r\n  --password <password>"]
[0,"o","                            Password for basic authentication to the API "]
[0,"o","\r\r\n"]
[0,"o","                                                   server\r\r\n  --profile <profile>                              Name of profile to capture. One of "]
[0.001,"o","\r\r\n                                                   (none|cpu|heap|goroutine|threadcreate|block|mutex"]
[0,"o","\r\r\n                                                   |trace) [default: none]\r\r\n  --profile-output <profile-output>                Name of the file to write the profile to \r\r\n                                                   [default: profile.pprof]\r\r\n  --proxy-url <proxy-url>                          Proxy URL to use for requests to the API server\r\r\n  --request-timeout <request-timeout>              The length of time to wait before giving up on a \r\r\n  "]
[0,"o","                                                 single server request. Non-zero values should "]
[0,"o","\r\r\n  "]
[0.001,"o","                                                 contain a corresponding time unit (e.g. 1s, 2m, \r\r\n  "]
[0,"o","                                                 3h). A value of zero means don't timeout "]
[0,"o","\r\r\n  "]
[0,"o","                                                 requests. [default: 0]\r\r\n  -s, --server <server>"]
[0,"o","                            The address and port of the Kubernetes API server"]
[0,"o","\r\r\n  --tls-server-name <tls-server-name>"]
[0.001,"o","              Server name to use for server certificate "]
[0,"o","\r\r\n                                                   validation. If it is not provided, the hostname "]
[0,"o","\r\r\n"]
[0,"o","                                                   used to contact the server is used"]
[0,"o","\r\r\n  --token <token>                                  Bearer token for authentication to the API server\r\r\n"]
[0.001,"o","  --user <user>"]
[0,"o","                                    The name of the kubeconfig user to use\r\r\n  --username <username>                            Username for basic authentication to the API \r\r\n                                                   server\r\r\n  -v <v>                                           number for the log level verbosity [default: 0]\r\r\n  --vmodule <vmodule>                              comma-separated list of pattern=N settings for \r\r\n                                                   file-filtered logging (only works for the \r\r\n                                                   default text log format)\r\r\n  --warnings-as-errors                             Treat warnings received from the server as \r\r\n                                                   errors and exit with a non-zero exit code\r\r\n  -?, -h, --help                                   Show help and usage information\r\r\n\r\r\n"]
[0.001,"o","Commands:\r\r\n"]
[0,"o","  completion <SHELL>"]
[0.001,"o","  Output shell completion code for bash, zsh, fish or powershell.\r\r\n  get <args>          Display one or many resources"]
[0,"o","\r\r\n\r\r\n\r\r\nFind more information at: https://kubernetes.io/docs/reference/kubectl/\r\r\n\r\r\nExamples:\r\r\n  # List pods in the current namespace\r\r\n  nkube get pods\r\r\n"]
